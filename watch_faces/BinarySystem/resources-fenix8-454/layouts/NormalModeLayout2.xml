<resources>
	<!-- Fenix 8 47mm (454x454): one centered column inside the binary ring.
	     Binary dots: hours left, minutes right, seconds bottom.
	     Panels come first so they are drawn behind their content. -->
	<layout id="NormalModeLayout2">
		<!-- shaded areas -->
		<drawable id="sunPanel" class="PanelView">
			<param name="x">102</param>
			<param name="y">97</param>
			<param name="w">250</param>
			<param name="h">40</param>
			<param name="radius">20</param>
		</drawable>
		<!-- trapezoid following the bowl between the date and the seconds dots -->
		<drawable id="activityPanel" class="PanelView">
			<param name="x">57</param>
			<param name="y">283</param>
			<param name="w">340</param>
			<param name="h">106</param>
			<param name="bottomWidth">170</param>
			<param name="radius">18</param>
		</drawable>

		<drawable id="binaryView" class="BinaryView">
			<param name="x">125</param>
			<param name="y">167</param>
			<param name="borderDistance">37</param>
			<param name="type">Circular</param>
			<param name="arcSegments">true</param>
			<param name="showSeconds">true</param>
		</drawable>

		<!-- battery: arc gauge on the top edge, percentage below it -->
		<drawable id="batteryView" class="BatteryView">
			<param name="batteryArc">true</param>
			<param name="arcInset">12</param>
			<param name="arcWidth">8</param>
			<param name="batteryBarHorizontal">true</param>
			<param name="batteryBarSize">.3</param>
			<param name="batteryBarThickness">.006</param>
			<param name="batteryBarLocX">.5</param>
			<param name="batteryBarLocY">.0507</param>
			<param name="percentFont">Graphics.FONT_XTINY</param>
			<param name="batteryPercentageLocX">0</param>
			<param name="batteryPercentageLocY">0</param>
		</drawable>

		<!-- status icons: alarm, Bluetooth, notifications (only active ones, centered) -->
		<drawable id="statusRow" class="StatusRowView">
			<param name="x">227</param>
			<param name="y">60</param>
		</drawable>

		<!-- sunrise / sunset -->
		<drawable id="sunView" class="SunView">
			<param name="textX">227</param>
			<param name="textY">96</param>
			<param name="iconX">218</param>
			<param name="iconY">109</param>
		</drawable>

		<!-- time and date -->
		<drawable id="timeView" class="TimeView">
			<param name="showTime">true</param>
			<param name="showDate">false</param>
			<param name="timeFont">Graphics.FONT_NUMBER_MEDIUM</param>
			<param name="x">.5</param>
			<param name="y">.2577</param>
		</drawable>
		<drawable id="dateView" class="TimeView">
			<param name="showTime">false</param>
			<param name="showDate">true</param>
			<param name="x">.5</param>
			<param name="y">.5176</param>
		</drawable>

		<!-- info panel: steps | distance, weather | sensor temperature, floors | heart rate -->
		<drawable id="sensorView" class="SensorView">
			<param name="x">227</param>
			<param name="y">285</param>
			<param name="w">270</param>
			<param name="rowHeight">34</param>
			<param name="innerOffset">62</param>
			<param name="tipOffset">50</param>
		</drawable>
	</layout>
</resources>
