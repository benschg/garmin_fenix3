<resources>
	<!-- Fenix 8 47mm (454x454): one centered column inside the binary ring.
	     Binary dots: hours left, minutes right, seconds bottom. -->
	<layout id="NormalModeLayout2">
		<drawable id="binaryView" class="BinaryView">
			<param name="x">125</param>
			<param name="y">167</param>
			<param name="borderDistance">37</param>
			<param name="type">Circular</param>
			<param name="showSeconds">true</param>
		</drawable>

		<!-- status icons -->
		<drawable id="alarmView" class="AlarmView">
			<param name="x">167</param>
			<param name="y">32</param>
		</drawable>
		<drawable id="bluetoothView" class="BluetoothView">
			<param name="x">207</param>
			<param name="y">32</param>
		</drawable>
		<drawable id="notificationView" class="NotificationView">
			<param name="x">247</param>
			<param name="y">37</param>
		</drawable>

		<!-- battery -->
		<drawable id="batteryView" class="BatteryView">
			<param name="batteryBarHorizontal">true</param>
			<param name="batteryBarSize">.3</param>
			<param name="batteryBarThickness">.006</param>
			<param name="batteryBarLocX">.5</param>
			<param name="batteryBarLocY">.155</param>
			<param name="batteryPercentageLocX">0</param>
			<param name="batteryPercentageLocY">.008</param>
		</drawable>

		<!-- sunrise / sunset -->
		<drawable id="sunView" class="SunView">
			<param name="textX">227</param>
			<param name="textY">106</param>
			<param name="iconX">218</param>
			<param name="iconY">112</param>
		</drawable>

		<!-- time and date -->
		<drawable id="timeView" class="TimeView">
			<param name="showTime">true</param>
			<param name="showDate">false</param>
			<param name="timeFont">Graphics.FONT_NUMBER_MEDIUM</param>
			<param name="x">.5</param>
			<param name="y">.275</param>
		</drawable>
		<drawable id="dateView" class="TimeView">
			<param name="showTime">false</param>
			<param name="showDate">true</param>
			<param name="x">.5</param>
			<param name="y">.53</param>
		</drawable>

		<!-- steps | distance -->
		<drawable id="activityView" class="ActivityView">
			<param name="x">227</param>
			<param name="y">284</param>
			<param name="centered">true</param>
			<param name="stepsXOffset">-80</param>
			<param name="stepsYOffset">0</param>
			<param name="showDistance">true</param>
			<param name="distanceXOffset">80</param>
			<param name="distanceYOffset">0</param>
		</drawable>

		<!-- floors | temperature | heart rate -->
		<drawable id="sensorView" class="SensorView">
			<param name="x">227</param>
			<param name="y">324</param>
			<param name="spacing">80</param>
		</drawable>
	</layout>
</resources>
